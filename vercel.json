{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/admin/comments/:id", "destination": "/api/admin/comment?id=:id" },
    { "source": "/api/stories/:slug", "destination": "/api/story?slug=:slug" },
    { "source": "/pt/historias/:slug/", "destination": "/story.html?lang=pt&slug=:slug" },
    { "source": "/en/stories/:slug/", "destination": "/story.html?lang=en&slug=:slug" },
    { "source": "/es/historias/:slug/", "destination": "/story.html?lang=es&slug=:slug" }
  ]
}
